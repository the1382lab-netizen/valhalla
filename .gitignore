# ── Unreal project (Valhalla2/) ─────────────────────────────
Valhalla2/Binaries/
Valhalla2/DerivedDataCache/
Valhalla2/Intermediate/
Valhalla2/Saved/
Valhalla2/Build/*
# B-27: the bundled PSO cache (Tools/perf/build_pso_cache.cmd) is committed so every package ships it
!Valhalla2/Build/Windows/
Valhalla2/Build/Windows/*
!Valhalla2/Build/Windows/PipelineCaches/
# Game data copied in by stage_game_data.py before packaging (source: shared/data)
Valhalla2/Content/Data/
Valhalla2/Plugins/**/Binaries/
Valhalla2/Plugins/**/Intermediate/
.vs/
.vscode/
*.VC.db
*.opensdf
*.opendb
*.sdf
*.sln
*.suo
*.xcodeproj
*.xcworkspace

# ── Node (server/, editor/, shared/, Tools/) ────────────────
node_modules/
dist/
*.tsbuildinfo
.vite/
.vite-temp/

# ── Local data, logs, backups ───────────────────────────────
# The dev account database: player accounts and password hashes, never committed.
server/*.db
*.log
*.bak
*.blend1

# ── OS / Python / local agent config ────────────────────────
Thumbs.db
.DS_Store
__pycache__/
*.pyc
.mcp.json

job*.done

# B-15: texture-set PNGs are regenerated from Poly Haven (see Import/Textures/texture_sets.json)
Import/Textures/**/*.png

# ── Hosting (deploy/README.md) ──────────────────────────────
# Secrets for the backend, the game server and the editor proxy. Never committed.
secrets.local.env
*.local.env
# Caddy binary, if dropped next to the Caddyfile instead of installed on PATH
deploy/caddy.exe
